# Copy to .env for local development. NEVER commit the real .env.
# In development the app runs with the defaults below even without a .env.

# Required in production; a dev default is used if unset.
DJANGO_SECRET_KEY=dev-only-change-me

# True for development, False for production.
DJANGO_DEBUG=True

# Comma-separated; required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production database. Leave unset to use local SQLite.
# DATABASE_URL=postgres://user:password@localhost:5432/nidaan
